POSTGRES_DB=ufam_planner
POSTGRES_USER=ufam_planner
POSTGRES_PASSWORD=ufam_planner
JWT_SECRET=change-this-development-secret-with-at-least-32-characters
APP_REFRESH_COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=/api/v1
APP_FRONTEND_BASE_URL=http://localhost:3000
# Crie uma credencial OAuth 2.0 do tipo aplicativo Web no Google Cloud.
# Use o mesmo ID no frontend e no backend; não coloque client secret no navegador.
GOOGLE_CLIENT_ID=
# No Docker local, e-mails de recuperação aparecem em http://localhost:8025.
APP_MAIL_FROM=nao-responda@ufamplanner.local
NEXT_PUBLIC_MAIL_TEST_MODE=true
# A busca de disciplinas processa gradualmente as grades públicas do eCampus.
UFAM_CATALOG_AUTO_SYNC_ENABLED=true
UFAM_CATALOG_SYNC_BATCH_SIZE=5
UFAM_CATALOG_SYNC_DELAY_MS=900000
